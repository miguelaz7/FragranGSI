    {
      "name": "Moloni",
      "description": "Preencher moloniClientId/Secret/Username/Password nas variáveis da coleção (valores do .env) — não fazer commit com eles.",
      "item": [
        {
          "name": "1. Token (password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token) {",
                  "  pm.collectionVariables.set(\"moloniToken\", j.access_token);",
                  "  pm.collectionVariables.set(\"moloniRefresh\", j.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Guarda o token em {{moloniToken}} (válido 1 h). Pedir outro invalida o da app: se a app estiver a correr, ela pede um novo sozinha.",
            "url": {
              "raw": "https://api.moloni.pt/v1/grant/?grant_type=password&client_id={{moloniClientId}}&client_secret={{moloniClientSecret}}&username={{moloniUsername}}&password={{moloniPassword}}",
              "protocol": "https",
              "host": [
                "api",
                "moloni",
                "pt"
              ],
              "path": [
                "v1",
                "grant",
                ""
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{moloniClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{moloniClientSecret}}"
                },
                {
                  "key": "username",
                  "value": "{{moloniUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{moloniPassword}}"
                }
              ]
            }
          }
        },
        {
          "name": "1b. Renovar token (refresh_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token) {",
                  "  pm.collectionVariables.set(\"moloniToken\", j.access_token);",
                  "  pm.collectionVariables.set(\"moloniRefresh\", j.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Guarda o token em {{moloniToken}} (válido 1 h). Pedir outro invalida o da app: se a app estiver a correr, ela pede um novo sozinha.",
            "url": {
              "raw": "https://api.moloni.pt/v1/grant/?grant_type=refresh_token&client_id={{moloniClientId}}&client_secret={{moloniClientSecret}}&refresh_token={{moloniRefresh}}",
              "protocol": "https",
              "host": [
                "api",
                "moloni",
                "pt"
              ],
              "path": [
                "v1",
                "grant",
                ""
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "client_id",
                  "value": "{{moloniClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{moloniClientSecret}}"
                },
                {
                  "key": "refresh_token",
                  "value": "{{moloniRefresh}}"
                }
              ]
            }
          }
        },

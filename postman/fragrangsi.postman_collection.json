    {
      "name": "SAP",
      "description": "OData v2 do S20. Autenticação Basic com {{sapUser}}/{{sapPassword}} (preencher a password nas variáveis; não fazer commit com ela). Para POST/PATCH é preciso primeiro o pedido \"Token CSRF\".",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{sapUser}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{sapPassword}}",
            "type": "string"

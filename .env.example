# Copiar para .env e preencher. O .env nunca vai para o git.

# PostgreSQL partilhado do grupo (Supabase → Connect → Direct → Session pooler, porta 5432)
DATABASE_URL="postgresql://postgres.PROJETO:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Segredo para assinar o cookie de sessão (gerar com: openssl rand -base64 32)
SESSION_SECRET=""

# --- SAP S/4HANA (OData v2) ---
SAP_BASE_URL="https://s20.gb.ucc.cit.tum.de/sap/opu/odata/sap"
SAP_CLIENT=""
SAP_USER=""
SAP_PASSWORD=""

# --- Moloni (API REST, OAuth2 grant password) ---
MOLONI_CLIENT_ID=""
MOLONI_CLIENT_SECRET=""
MOLONI_USERNAME=""
MOLONI_PASSWORD=""
MOLONI_COMPANY_ID=""
MOLONI_DOCUMENT_SET_ID=""
MOLONI_TAX_ID=""
MOLONI_UNIT_ID=""


# --- Catálogo SAP (estrutura organizacional usada no projeto) ---
SAP_PRODUCT_PREFIX="PERF"
SAP_PLANT="HD00"
SAP_SALES_ORG="DS00"
SAP_DISTRIBUTION_CHANNEL="WH"

# --- Assistente IA (Google AI Studio / Gemini) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Sincronização automática (n8n → POST /api/sync). Gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SYNC_TOKEN=""
